# Copy this file to .env and fill in real values before running the server.

# Port the API server listens on
PORT=4000

# Secret used to sign JWT session tokens — set this to a long random string in production
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=12h

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/investment.db

# Comma-separated list of allowed frontend origins (CORS). For local dev with the
# provided frontend served via `npx serve` / VSCode Live Server, this usually covers it.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080

# Default owner account created on first run if no users exist yet
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# Smart-DCA engine settings — ported from Smart-DCA/config.py
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
EMA_PERIOD=26
DATA_PERIOD=1y
REBALANCE_TOLERANCE=0.5
VOL_WINDOW=20
VOL_DCA_CAP=1.5

# How long (minutes) fetched market data (price/RSI/MACD/EMA/volatility) is cached
# per symbol before re-fetching from Yahoo Finance, to avoid rate limits.
MARKET_CACHE_MINUTES=60
